{
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/cebador",
      "destination": "/cebador/",
      "permanent": false
    },
    {
      "source": "/sonria",
      "destination": "/sonria/",
      "permanent": false
    },
    {
      "source": "/miga",
      "destination": "/miga/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/cebador/",
      "destination": "https://nahuelmosse.github.io/cebador-landing/"
    },
    {
      "source": "/cebador/:path*",
      "destination": "https://nahuelmosse.github.io/cebador-landing/:path*"
    },
    {
      "source": "/sonria/",
      "destination": "https://nahuelmosse.github.io/sonria/"
    },
    {
      "source": "/sonria/:path*",
      "destination": "https://nahuelmosse.github.io/sonria/:path*"
    },
    {
      "source": "/miga/",
      "destination": "https://nahuelmosse.github.io/miga/"
    },
    {
      "source": "/miga/:path*",
      "destination": "https://nahuelmosse.github.io/miga/:path*"
    },
    {
      "source": "/api/profile/:path*",
      "destination": "https://profile-widgets.vercel.app/api/profile/:path*"
    }
  ]
}
